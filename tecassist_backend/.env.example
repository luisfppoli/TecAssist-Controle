# Adicionar seu usuario postgres em "user" e sua senha em "password"
# Trocar "meubanco" para o nome do seu banco de dados
# Alterar as variaveis caso necessite

DATABASE_URL="postgresql://user:password@localhost:5432/meubanco"
JWT_SECRET="sua-chave-secreta"
REGISTRATION_CODE_SECRET=seu-codigo-de-registro
ADMIN_NAME=nome-do-seu-user-admin
ADMIN_EMAIL=email-do-seu-user-admin
ADMIN_PASSWORD=senha-do-seu-user-admin

# No caso de usar uma URL hospedada, altere DATABASE_URL para:
# DATABASE_URL="postgresql://sua-url"
